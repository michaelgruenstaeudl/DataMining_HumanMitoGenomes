// Configuration is split by responsibility. The legacy parameter names remain
// available so existing command lines continue to work.
includeConfig "${projectDir}/conf/base.config"
includeConfig "${projectDir}/conf/modules.config"

profiles {
    local {
        process.executor = 'local'
        apptainer.enabled = false
        docker.enabled = false
    }

    apptainer {
        process.executor = 'local'
        apptainer.enabled = true
        docker.enabled = false
    }

    docker {
        process.executor = 'local'
        docker.enabled = true
        apptainer.enabled = false
    }

    test {
        includeConfig "${projectDir}/conf/test.config"
    }
}
