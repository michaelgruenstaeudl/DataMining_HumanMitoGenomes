/*
 * Resource-light test profile. A project-specific input CSV and associated
 * files must still be supplied; no synthetic scientific dataset is assumed.
 */

params {
    is_calculate_evenness = false
    outdir = 'results_test'
}

process {
    executor = 'local'
    cpus = 1
    memory = 2.GB
    time = 30.m
}
